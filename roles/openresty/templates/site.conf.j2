# {{ ansible_managed }}
# Static site: https://{{ site_domain }} serves the production release;
# http:// and www. redirect there.

server {
    listen 80;
    server_name {{ site_domain }} www.{{ site_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

{% if openresty_tls_ready | bool %}
    location / {
        return 301 https://{{ site_domain }}$request_uri;
    }
{% else %}
    root {{ site_root }}/production;
    index index.html;

    location = / {
        rewrite_by_lua_block {
            require("site_lang").redirect("{{ site_default_lang }}")
        }
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Astro puts a content hash in /_astro/ names: a new build means a new
    # URL. /assets/ names carry no hash: rename the file when it changes.
    # expires, not add_header: an add_header here would drop the server's HSTS.
    location /_astro/ {
        expires 1y;
        try_files $uri =404;
    }

    location /assets/ {
        expires 30d;
        try_files $uri =404;
    }
{% endif %}
}
{% if openresty_tls_ready | bool %}

server {
    listen 443 ssl;
    http2 on;
    server_name www.{{ site_domain }};

    ssl_certificate {{ openresty_site_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ openresty_site_cert_dir }}/privkey.pem;

    return 301 https://{{ site_domain }}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ site_domain }};

    ssl_certificate {{ openresty_site_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ openresty_site_cert_dir }}/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    root {{ site_root }}/production;
    index index.html;

    location = / {
        rewrite_by_lua_block {
            require("site_lang").redirect("{{ site_default_lang }}")
        }
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Astro puts a content hash in /_astro/ names: a new build means a new
    # URL. /assets/ names carry no hash: rename the file when it changes.
    # expires, not add_header: an add_header here would drop the server's HSTS.
    location /_astro/ {
        expires 1y;
        try_files $uri =404;
    }

    location /assets/ {
        expires 30d;
        try_files $uri =404;
    }
}
{% endif %}
