# {{ ansible_managed }}
user openresty;
worker_processes 1;
pid logs/nginx.pid;
# Logs go to journald, which enforces the disk limit.
error_log syslog:server=unix:/dev/log,tag=openresty warn;

events {
    worker_connections 512;
}

http {
    include mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" rt=$request_time '
                    'upstream=$upstream_addr ut=$upstream_response_time';
    access_log syslog:server=unix:/dev/log,tag=openresty main;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json text/csv;

    include conf.d/*.conf;
}
