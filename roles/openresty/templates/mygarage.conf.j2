# {{ ansible_managed }}
upstream mygarage {
    # Switched atomically by /opt/mygarage/bin/deploy.sh (blue/green).
    include {{ deploy_state_dir }}/upstream.conf;
    keepalive 16;
}

{% macro proxy() %}
        proxy_pass http://mygarage;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
{% endmacro %}

server {
    listen 80 default_server;
    server_name {{ mygarage_domain or '_' }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

{% if openresty_tls_ready | bool %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    client_max_body_size {{ proxy_client_max_body_size }};

    location / {
        auth_basic "myGarage";
        auth_basic_user_file mygarage.htpasswd;
{{ proxy() }}
    }
{% endif %}
}
{% if openresty_tls_ready | bool %}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ mygarage_domain }};

    ssl_certificate {{ openresty_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ openresty_cert_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:5m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size {{ proxy_client_max_body_size }};

    location / {
        auth_basic "myGarage";
        auth_basic_user_file mygarage.htpasswd;
{{ proxy() }}
    }
}
{% endif %}

# Loopback-only entry for deploy smoke tests and monitoring: same upstream,
# no authentication.
server {
    listen 127.0.0.1:{{ proxy_check_port }};
    server_name localhost;

    location ~ ^/(healthz|readyz|version)$ {
{{ proxy() }}
    }

    location / {
        return 404;
    }
}
