# {{ ansible_managed }}
CHECK_URL=http://127.0.0.1:{{ proxy_check_port }}
STATE_DIR={{ deploy_state_dir }}
DISK_MAX_PERCENT={{ monitor_disk_max_percent }}
SWAP_MAX_PERCENT={{ monitor_swap_max_percent }}
MEM_MIN_AVAILABLE_MB={{ monitor_mem_min_available_mb }}
# Space-separated certificates whose expiry is checked.
{% set certs = ([mygarage_domain, site_domain] | select | list) if mygarage_tls_enabled | bool else [] %}
TLS_CERTS="{% for d in certs %}/etc/letsencrypt/live/{{ d }}/fullchain.pem{{ ' ' if not loop.last }}{% endfor %}"
TLS_MIN_DAYS={{ monitor_tls_min_days }}
BACKUP_DIR={{ backup_dir }}
ALERT_URL={{ monitor_alert_url }}
