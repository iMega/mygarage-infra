# {{ ansible_managed }}
# Loaded before 50-redhat.conf: the first value of each option wins.
Port {{ ssh_port }}
PermitRootLogin {{ 'yes' if ssh_permit_root_login | bool else 'no' }}
PasswordAuthentication {{ 'yes' if ssh_password_authentication | bool else 'no' }}
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
AllowUsers {{ admin_user }} {{ deploy_user }}{{ (' ' + site_user) if site_domain | length > 0 else '' }}{{ ' root' if ssh_permit_root_login | bool else '' }}
